 class="required">*</span></label>
                  <input type="password" class="form-control" name="password" value="<%= vm ? (vm.password || '') : '' %>"
                    <%= vm && vm.status !== 'stopped' ? 'disabled' : '' %> placeholder="SSH password">
                  <div class="form-hint">Cloud-init will be regenerated when changed. Used for SSH authentication.</div>
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- Network Tab -->
        <div class="tab-pane" id="tab-network">
          <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 20px;">
            <div class="card">
              <div class="card-header">
                <div class="card-title"><i class="fas fa-ethernet" style="color: #3B82F6;"></i> IPv4 Configuration</div>
              </div>
              <div class="card-body">
                <div class="form-group">
                  <label class="form-label">Network Type</label>
                  <select class="form-control" name="network_type" id="networkTypeSelect" <%= vm && vm.status !== 'stopped' ? 'disabled' : '' %> onchange="updateNetworkFields()">
                    <option value="dhcp" <%= vm && vm.network_type === 'dhcp' ? 'selected' : '' %>>DHCP (Automatic)</option>
                    <option value="static_public" <%= vm && vm.network_type === 'static_public' ? 'selected' : '' %>>Static Public IPv4</option>
                    <option value="static_private" <%= vm && vm.network_type === 'static_private' ? 'selected' : '' %>>Static Private IPv4</option>
                    <option value="dual_stack" <%= vm && vm.network_type === 'dual_stack' ? 'selected' : '' %>>Dual Stack (IPv4 + IPv6)</option>
                  </select>
                </div>

                <div id="staticIpFields" style="display: none;">
                  <div class="form-group">
                    <label class="form-label">IPv4 Address <span class="required">*</span></label>
                    <input type="text" class="form-control" name="ipv4_address" value="<%= vm ? (vm.ipv4_address || '') : '' %>"
                      <%= vm && vm.status !== 'stopped' ? 'disabled' : '' %> placeholder="e.g., 192.168.1.100">
                  </div>
                  <div class="form-row">
                    <div class="form-group">
                      <label class="form-label">Gateway <span class="required">*</span></label>
                      <input type="text" class="form-control" name="ipv4_gateway" value="<%= vm ? (vm.ipv4_gateway || vm.gateway || '') : '' %>"
                        id="edit_ipv4_gateway"
                        <%= vm && vm.status !== 'stopped' ? 'disabled' : '' %> placeholder="192.168.1.1">
                    </div>
                    <div class="form-group">
                      <label class="form-label">Netmask (CIDR) <span class="required">*</span></label>
                      <input type="number" class="form-control" name="ipv4_netmask" value="<%= vm ? (vm.ipv4_netmask || vm.netmask || '24') : '24' %>"
                        id="edit_ipv4_netmask"
                        <%= vm && vm.status !== 'stopped' ? 'disabled' : '' %> min="1" max="32" placeholder="24">
                    </div>
                  </div>
                </div>

                <div class="form-group" style="margin-bottom: 0;">
                  <label class="form-label">DNS Servers</label>
                  <input type="text" class="form-control" name="dns_primary" value="<%= vm ? (vm.dns_primary || '8.8.8.8') : '8.8.8.8' %>"
                    id="edit_dns_primary"
                    <%= vm && vm.status !== 'stopped' ? 'disabled' : '' %> placeholder="8.8.8.8">
                </div>
              </div>
            </div>

            <div>
              <div class="card" style="margin-bottom: 16px;">
                <div class="card-header">
                  <div class="card-title"><i class="fas fa-plug" style="color: #EC4899;"></i> Port Forwarding</div>
                </div>
                <div class="card-body">
                  <div class="form-row">
                    <div class="form-group">
                      <label class="form-label">SSH Port</label>
                      <input type="number" class="form-control" name="ssh_port_static" value="<%= vm ? (vm.ssh_port || vm.ssh_port_static || 22) : 22 %>"
                        <%= vm && vm.status !== 'stopped' ? 'disabled' : '' %> min="1" max="65535">
                    </div>
                    <div class="form-group">
                      <label class="form-label">HTTP Port</label>
                      <input type="number" class="form-control" name="http_port" value="<%= vm ? (vm.http_port || 80) : 80 %>"
                        <%= vm && vm.status !== 'stopped' ? 'disabled' : '' %> min="1" max="65535">
                    </div>
                  </div>
                </div>
              </div>

              <div class="card" style="margin-bottom: 16px;" id="ipv6Fields" style="display: none;">
                <div class="card-header">
                  <div class="card-title"><i class="fas fa-globe" style="color: #06B6D4;"></i> IPv6</div>
                </div>
                <div class="card-body">
                  <div class="form-group">
                    <label class="form-label">IPv6 Address</label>
                    <input type="text" class="form-control" name="ipv6_address" value="<%= vm ? (vm.ipv6_address || '') : '' %>"
                      <%= vm && vm.status !== 'stopped' ? 'disabled' : '' %> placeholder="Optional IPv6 address">
                  </div>
                  <div class="form-group" style="margin-bottom: 0;">
                    <label class="form-label">IPv6 Gateway</label>
                    <input type="text" class="form-control" name="ipv6_gateway" value="<%= vm ? (vm.ipv6_gateway || '') : '' %>"
                      <%= vm && vm.status !== 'stopped' ? 'disabled' : '' %> placeholder="Optional IPv6 gateway">
                  </div>
                </div>
              </div>

              <div class="card">
                <div class="card-header">
                  <div class="card-title"><i class="fas fa-sitemap" style="color: #F59E0B;"></i> MAC & VLAN</div>
                </div>
                <div class="card-body">
                  <div class="form-group">
                    <label class="form-label">MAC Address</label>
                    <input type="text" class="form-control" name="mac_address" value="<%= vm ? (vm.mac_address || '') : '' %>"
                      <%= vm && vm.status !== 'stopped' ? 'disabled' : '' %> placeholder="Auto-generated" style="font-family: monospace;">
                  </div>
                  <div class="form-group" style="margin-bottom: 0;">
                    <label class="form-label">VLAN ID</label>
                    <input type="number" class="form-control" name="vlan_id" value="<%= vm ? (vm.vlan_id || '') : '' %>"
                      <%= vm && vm.status !== 'stopped' ? 'disabled' : '' %> placeholder="Optional VLAN tag">
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- BIOS Tab -->
        <div class="tab-pane" id="tab-bios">
          <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 20px;">
            <div class="card">
              <div class="card-header">
                <div class="card-title"><i class="fas fa-sliders-h" style="color: #8B5CF6;"></i> SMBIOS Configuration</div>
              </div>
              <div class="card-body">
                <div class="form-group">
                  <label class="form-label">Manufacturer</label>
                  <div style="display: grid; gap: 8px;">
                    <select class="form-control" name="smbios_manufacturer" id="edit_smbios_manufacturer" onchange="toggleCustomManufacturerEdit()" <%= vm && vm.status !== 'stopped' ? 'disabled' : '' %>>
                      <% ['QEMU', 'Proxmox', 'Red Hat', 'VirtualBox', 'Microsoft Corporation', 'Dell Inc.', 'HP Inc.', 'Lenovo'].forEach(m => { %>
                      <option value="<%= m %>" <%= vm && vm.smbios_manufacturer === m ? 'selected' : '' %>><%= m %></option>
                      <% }); %>
                      <option value="custom" <%= vm && !['QEMU', 'Proxmox', 'Red Hat', 'VirtualBox', 'Microsoft Corporation', 'Dell Inc.', 'HP Inc.', 'Lenovo'].includes(vm.smbios_manufacturer) ? 'selected' : '' %>>Custom...</option>
                    </select>
                    <input type="text" class="form-control" name="custom_manufacturer_edit" id="custom_manufacturer_edit" value="<%= vm && vm.smbios_manufacturer && !['QEMU', 'Proxmox', 'Red Hat', 'VirtualBox', 'Microsoft Corporation', 'Dell Inc.', 'HP Inc.', 'Lenovo'].includes(vm.smbios_manufacturer) ? vm.smbios_manufacturer : '' %>" placeholder="Enter custom manufacturer name" style="<%= vm && vm.smbios_manufacturer && !['QEMU', 'Proxmox', 'Red Hat', 'VirtualBox', 'Microsoft Corporation', 'Dell Inc.', 'HP Inc.', 'Lenovo'].includes(vm.smbios_manufacturer) ? 'display: block; border-color: #6366F1;' : 'display: none; border-color: #6366F1;' %>" <%= vm && vm.status !== 'stopped' ? 'disabled' : '' %>>
                  </div>
                </div>
                <div class="form-group">
                  <label class="form-label">Product Name</label>
                  <div style="display: grid; gap: 8px;">
                    <select class="form-control" name="smbios_product" id="edit_smbios_product" onchange="toggleCustomProductEdit()" <%= vm && vm.status !== 'stopped' ? 'disabled' : '' %>>
                      <% ['KVM Virtual Machine', 'Standard PC', 'RHEL Guest', 'VirtualBox', 'Virtual Machine', 'Cloud Instance'].forEach(p => { %>
                      <option value="<%= p %>" <%= vm && vm.smbios_product === p ? 'selected' : '' %>><%= p %></option>
                      <% }); %>
                      <option value="custom" <%= vm && !['KVM Virtual Machine', 'Standard PC', 'RHEL Guest', 'VirtualBox', 'Virtual Machine', 'Cloud Instance'].includes(vm.smbios_product) ? 'selected' : '' %>>Custom...</option>
                    </select>
                    <input type="text" class="form-control" name="custom_product_edit" id="custom_product_edit" value="<%= vm && vm.smbios_product && !['KVM Virtual Machine', 'Standard PC', 'RHEL Guest', 'VirtualBox', 'Virtual Machine', 'Cloud Instance'].includes(vm.smbios_product) ? vm.smbios_product : '' %>" placeholder="Enter custom product name" style="<%= vm && vm.smbios_product && !['KVM Virtual Machine', 'Standard PC', 'RHEL Guest', 'VirtualBox', 'Virtual Machine', 'Cloud Instance'].includes(vm.smbios_product) ? 'display: block; border-color: #6366F1;' : 'display: none; border-color: #6366F1;' %>" <%= vm && vm.status !== 'stopped' ? 'disabled' : '' %>>
                  </div>
                </div>
                <div class="form-row">
                  <div class="form-group">
                    <label class="form-label">BIOS Version</label>
                    <input type="text" class="form-control" name="smbios_version" value="<%= vm ? (vm.smbios_version || '1.0') : '1.0' %>"
                      <%= vm && vm.status !== 'stopped' ? 'disabled' : '' %>>
                  </div>
                  <div class="form-group">
                    <label class="form-label">Serial Number</label>
                    <input type="text" class="form-control" name="smbios_serial" value="<%= vm ? (vm.smbios_serial || '') : '' %>"
                      <%= vm && vm.status !== 'stopped' ? 'disabled' : '' %> placeholder="Auto-generated">
                  </div>
                </div>
              </div>
            </div>

            <div class="card">
              <div class="card-header">
                <div class="card-title"><i class="fas fa-server" style="color: #6366F1;"></i> Board / Product</div>
              </div>
              <div class="card-body">
                <div class="form-group">
                  <label class="form-label">Machine Type</label>
                  <select class="form-control" name="machine_type" <%= vm && vm.status !== 'stopped' ? 'disabled' : '' %>>
                    <optgroup label="x86-64 / i386">
                      <option value="pc" <%= vm && vm.machine_type === 'pc' ? 'selected' : '' %>>PC (i440fx - Standard, Legacy)</option>
                      <option value="q35" <%= vm && vm.machine_type === 'q35' ? 'selected' : '' %>>Q35 (ICH9 - Modern, Recommended)</option>
                      <option value="microvm" <%= vm && vm.machine_type === 'microvm' ? 'selected' : '' %>>MicroVM (Minimal, Fast Boot)</option>
                    </optgroup>
                    <optgroup label="ARM">
                      <option value="virt" <%= vm && vm.machine_type === 'virt' ? 'selected' : '' %>>Virtual (ARM Generic Platform)</option>
                      <option value="versatilepb" <%= vm && vm.machine_type === 'versatilepb' ? 'selected' : '' %>>Versatile Platform Baseboard</option>
                      <option value="raspi2" <%= vm && vm.machine_type === 'raspi2' ? 'selected' : '' %>>Raspberry Pi 2</option>
                      <option value="raspi3" <%= vm && vm.machine_type === 'raspi3' ? 'selected' : '' %>>Raspberry Pi 3</option>
                    </optgroup>
                    <optgroup label="Enterprise">
                      <option value="pseries" <%= vm && vm.machine_type === 'pseries' ? 'selected' : '' %>>POWER Series (PowerPC)</option>
                      <option value="s390-ccw-virtio" <%= vm && vm.machine_type === 's390-ccw-virtio' ? 'selected' : '' %>>IBM System Z (s390x)</option>
                    </optgroup>
                  </select>
                  <div class="form-hint" style="font-size: 12px; color: var(--text-muted); margin-top: 6px;">
                    <strong>x86-64:</strong> PC for legacy OS, Q35 for modern OS, MicroVM for minimal overhead
                  </div>
                </div>
                <div class="form-group">
                  <label class="form-label">Board Name</label>
                  <input type="text" class="form-control" name="board_name" value="<%= vm ? (vm.board_name || 'Main-Board') : 'Main-Board' %>"
                    <%= vm && vm.status !== 'stopped' ? 'disabled' : '' %>>
                </div>
                <div class="form-group" style="margin-bottom: 0;">
                  <label class="form-label">Product Name</label>
                  <input type="text" class="form-control" name="product_name" value="<%= vm ? (vm.product_name || 'Virtual Machine') : 'Virtual Machine' %>"
                    <%= vm && vm.status !== 'stopped' ? 'disabled' : '' %>>
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- Action Bar -->
        <div style="display: flex; justify-content: flex-end; gap: 12px; margin-top: 24px; padding: 16px; background: var(--bg-card); border-radius: var(--radius-lg); border: 1px solid var(--border-card);">
          <a href="/admin/vm/<%= vmId %>" class="btn btn-ghost">Cancel</a>
          <button type="button" class="btn btn-danger" id="reinstallBtn" onclick="showReinstallModal()" <%= vm && vm.status !== 'stopped' ? 'disabled' : '' %>>
            <i class="fas fa-sync-alt"></i>
            Reinstall VM
          </button>
          <button type="submit" class="btn btn-primary" id="saveBtn" <%= vm && vm.status !== 'stopped' ? 'disabled' : '' %>>
            <i class="fas fa-save"></i>
            Save Changes
          </button>
        </div>
      </form>

    </div>

    <%- include('../partials/admin/footer') %>
  </div>
</div>

<script>
const vmId = <%= vmId %>;

// Reinstall Modal Functions
function showReinstallModal() {
  const modal = document.getElementById('reinstallModal');
  if (!modal) {
    createReinstallModal();
    setTimeout(() => {
      const newModal = document.getElementById('reinstallModal');
      if (newModal) {
        newModal.classList.add('show');
      }
    }, 10);
  } else {
    modal.classList.add('show');
  }
}

function closeReinstallModal() {
  const modal = document.getElementById('reinstallModal');
  if (modal) modal.classList.remove('show');
}

function createReinstallModal() {
  const modal = document.createElement('div');
  modal.id = 'reinstallModal';
  modal.className = 'modal-overlay';
  
  modal.innerHTML = `
    <div class="modal-content" style="background-color: var(--bg-card); border: 1px solid var(--border-color); border-radius: var(--radius-lg); width: 90%; max-width: 500px; padding: 0; box-shadow: 0 10px 40px rgba(0,0,0,0.3); margin: auto;">
      <!-- Header -->
      <div style="padding: 20px; border-bottom: 1px solid var(--border-color); display: flex; justify-content: space-between; align-items: center;">
        <h2 style="margin: 0; color: var(--text-primary); font-size: 18px; font-weight: 600;">
          <i class="fas fa-sync-alt" style="color: #F59E0B; margin-right: 8px;"></i>
          Reinstall VM
        </h2>
        <button type="button" onclick="closeReinstallModal()" style="background: none; border: none; color: var(--text-muted); cursor: pointer; font-size: 20px;">
          <i class="fas fa-times"></i>
        </button>
      </div>
      
      <!-- Body -->
      <div style="padding: 20px;">
        <div class="alert alert-warning" style="margin-bottom: 16px;">
          <i class="fas fa-exclamation-triangle" style="color: #F59E0B;"></i>
          <strong>Warning!</strong> This will delete the VM disk and cloud-init seed. Logs will be kept for audit trail.
        </div>
        
        <form id="reinstallForm" onsubmit="performReinstall(event)">
          <div class="form-group">
            <label class="form-label" style="font-weight: 600;">Select OS Template <span class="required">*</span></label>
            <select class="form-control" name="new_os_template" id="reinstall_template" required style="margin-bottom: 12px;">
              <option value="">— Choose Template —</option>
            </select>
            <div class="form-hint" style="color: var(--text-muted);">Select a new OS to reinstall. Keep current or choose different.</div>
          </div>
          
          <div class="form-group">
            <label class="form-label" style="font-weight: 600;">New Username (Optional)</label>
            <input type="text" class="form-control" name="new_username" id="reinstall_username" placeholder="Leave blank to keep current">
            <div class="form-hint">Default user for cloud-init templates (ubuntu, debian, root, etc.)</div>
          </div>
          
          <div class="form-group">
            <label class="form-label" style="font-weight: 600;">New Password (Optional)</label>
            <input type="password" class="form-control" name="new_password" id="reinstall_password" placeholder="Leave blank to keep current">
            <div class="form-hint">SSH password for the new installation</div>
          </div>
          
          <label class="toggle-switch" style="margin: 16px 0;">
            <input type="checkbox" class="toggle-input" name="confirm" id="reinstall_confirm" required>
            <div class="toggle-track"><div class="toggle-thumb"></div></div>
            <div>
              <div class="toggle-label" style="font-size: 13px; color: var(--text-primary);">I understand this will delete all VM data</div>
            </div>
          </label>
        </form>
      </div>
      
      <!-- Footer -->
      <div style="padding: 16px; border-top: 1px solid var(--border-color); display: flex; justify-content: flex-end; gap: 8px;">
        <button type="button" class="btn btn-ghost" onclick="closeReinstallModal()">Cancel</button>
        <button type="button" class="btn btn-danger" id="confirmReinstallBtn" onclick="document.getElementById('reinstallForm').dispatchEvent(new Event('submit'))">
          <i class="fas fa-sync-alt"></i>
          Reinstall
        </button>
      </div>
    </div>
  `;
  
  document.body.appendChild(modal);
  
  // Load templates into select
  loadTemplatesForReinstall();
  
  // Close on background click
  modal.addEventListener('click', function(e) {
    if (e.target === modal) closeReinstallModal();
  });
}

async function loadTemplatesForReinstall() {
  try {
    const res = await fetch('/api/admin/templates');
    if (!res.ok) throw new Error('Failed to load templates');
    
    const templates = await res.json();
    const select = document.getElementById('reinstall_template');
    if (!select) return;
    
    // Add built-in templates
    const builtIn = {
      'ubuntu_22_cloud': 'Ubuntu 22.04 LTS (Cloud)',
      'ubuntu_24_cloud': 'Ubuntu 24.04 LTS (Cloud)',
      'debian_12_cloud': 'Debian 12 (Cloud)',
      'fedora_40_cloud': 'Fedora 40 (Cloud)',
      'centos_9_cloud': 'CentOS 9 Stream (Cloud)',
      'almalinux_9_cloud': 'AlmaLinux 9 (Cloud)'
    };
    
    Object.entries(builtIn).forEach(([