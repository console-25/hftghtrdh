<script>
// Sidebar functionality
function toggleSidebar() {
  const sidebar = document.getElementById('adminSidebar');
  const overlay = document.getElementById('sidebarOverlay');
  sidebar.classList.toggle('open');
  overlay.classList.toggle('open');
  document.body.style.overflow = sidebar.classList.contains('open') ? 'hidden' : '';
}

function closeSidebar() {
  const sidebar = document.getElementById('adminSidebar');
  const overlay = document.getElementById('sidebarOverlay');
  sidebar.classList.remove('open');
  overlay.classList.remove('open');
  document.body.style.overflow = '';
}

// Modal functions
function openModal(id) {
  document.getElementById(id).classList.add('show');
  document.body.style.overflow = 'hidden';
}

function closeModal(id) {
  document.getElementById(id).classList.remove('show');
  document.body.style.overflow = '';
}

function openQuickActions() { openModal('quickActionsModal'); }
function openSystemInfo() { openModal('systemInfoModal'); }

// Close modal on overlay click
document.addEventListener('click', (e) => {
  if (e.target.classList.contains('modal-overlay')) {
    document.querySelectorAll('.modal-overlay').forEach(m => {
      m.classList.remove('show');
    });
    document.body.style.overflow = '';
  }
});

// Load sidebar stats
async function loadSidebarStats() {
  try {
    const [vmsRes, settingsRes] = await Promise.all([
      fetch('/api/vms'),
      fetch('/api/settings')
    ]);
    
    if (vmsRes.ok) {
      const vms = await vmsRes.json();
      const runningCount = vms.filter(vm => vm.status === 'running').length;
      const vmCountBadge = document.getElementById('vmCountBadge');
      const runningBadge = document.getElementById('runningBadge');
      
      if (vmCountBadge) {
        vmCountBadge.textContent = vms.length;
        vmCountBadge.style.display = 'inline-flex';
      }
      
      if (runningBadge) {
        runningBadge.textContent = runningCount;
        runningBadge.style.display = runningCount > 0 ? 'inline-flex' : 'none';
      }
    }
    
    if (settingsRes.ok) {
      const settings = await settingsRes.json();
      const siteName = settings['site_name'] || '<%= siteName %>';
      const nameEl = document.getElementById('sidebarName');
      if (nameEl) {
        nameEl.textContent = siteName;
      }
    }
  } catch(e) {
    console.error('Failed to load sidebar data:', e);
  }
}

// Load sidebar data on page load
if (document.readyState === 'loading') {
  document.addEventListener('DOMContentLoaded', loadSidebarStats);
} else {
  loadSidebarStats();
}

// Refresh stats every 30 seconds
setInterval(loadSidebarStats, 30000);
</script>{"mode":33188,"size":19458,"isFileValue":true,"isDirectoryValue":false,"isSocketValue":false,"isSymbolicLinkValue":false}<link rel="stylesheet" href="/css/admin.css">
