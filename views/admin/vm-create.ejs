<script>
function escapeHtml(text) {
  const map = {'&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#039;'};
  return String(text).replace(/[&<>"']/g, m => map[m]);
}

function showMessage(message, type) {
  const container = document.getElementById('messageContainer');
  const alertClass = type === 'success' ? 'alert alert-success' : 'alert alert-error';
  const icon = type === 'success' ? '<svg width="16" height="16" style="flex-shrink:0;"><use href="#i-check"/></svg>' : '<svg width="16" height="16" style="flex-shrink:0;"><use href="#i-alert"/></svg>';
  
  const alertDiv = document.createElement('div');
  alertDiv.className = alertClass;
  alertDiv.style.display = 'flex';
  alertDiv.style.gap = '12px';
  alertDiv.style.alignItems = 'flex-start';
  alertDiv.innerHTML = `${icon}<div style="flex:1; font-size:13px;">${escapeHtml(message)}</div>`;
  
  container.innerHTML = '';
  container.appendChild(alertDiv);
  
  if (type === 'success') {
    setTimeout(() => {
      alertDiv.style.opacity = '0';
      alertDiv.style.transition = 'opacity 0.3s';
      setTimeout(() => alertDiv.remove(), 300);
    }, 2000);
  }
}

async function handleActivate(event) {
  event.preventDefault();
  
  const licenseKey = document.getElementById('licenseKeyInput').value.trim();
  const btn = document.getElementById('activateBtn');
  const originalText = btn.innerHTML;
  
  if (!licenseKey) {
    showMessage('Please enter a license key', 'error');
    return;
  }
  
  btn.disabled = true;
  btn.innerHTML = '<svg width="16" height="16" style="animation:spin 0.6s linear infinite;"><use href="#i-refresh"/></svg>Activating...';
  
  try {
    const response = await fetch('/api/license/activate', {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json'
      },
      body: JSON.stringify({ license_key: licenseKey })
    });
    
    const data = await response.json();
    
    if (data.success) {
      showMessage(data.message, 'success');
      setTimeout(() => {
        window.location.href = data.redirect || '/login';
      }, 1500);
    } else {
      showMessage(data.message || 'Failed to activate license', 'error');
      btn.disabled = false;
      btn.innerHTML = originalText;
    }
  } catch (error) {
    showMessage('Network error: ' + error.message, 'error');
    btn.disabled = false;
    btn.innerHTML = originalText;
  }
}

async function checkLicenseStatus() {
  try {
    const response = await fetch('/api/license/status');
    const data = await response.json();
    const statusText = document.getElementById('statusText');
    
    if (data.activated) {
      statusText.innerHTML = `<span style="color:var(--color-emerald);">✓ License is ACTIVE</span><br>Owner: ${escapeHtml(data.owner || 'Unknown')}`;
    } else {
      statusText.innerHTML = '<span style="color:var(--color-red);">⚠ No active license</span>';
    }
  } catch (error) {
    document.getElementById('statusText').innerHTML = 'Unable to check license status';
  }
}

// Check status on page load
document.addEventListener('DOMContentLoaded', checkLicenseStatus);

// Spin animation
const style = document.createElement('style');
style.innerHTML = `
  @keyframes spin {
    from { transform: rotate(0deg); }
    to { transform: rotate(360deg); }
  }
`;
document.head.appendChild(style);
</script>
</body>
</html>
