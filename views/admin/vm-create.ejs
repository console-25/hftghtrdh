<!-- Footer (minimal, inside page) -->
<div style="padding: 16px 28px; border-top: 1px solid var(--border-subtle); display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 8px; margin-top: 40px;">
  <div style="font-size: 11px; color: var(--text-muted);">
