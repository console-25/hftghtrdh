<div class="admin-wrapper">
  <%- include('../partials/users/sidebar') %>

  <div class="admin-main">
    <%- include('../partials/admin/header') %>

    <div class="admin-content">

      <!-- Enhanced Header (No purple background, no server icon) -->
      <div class="page-header-enhanced">
        <div style="position: relative; z-index: 1;">
          <h1 class="page-title-enhanced">
            <!-- title icon removed -->
            My Virtual Machines
          </h1>
          <p class="page-subtitle-enhanced">
            Welcome back, <strong style="color: var(--accent-primary);"><%= user.username %></strong>
            <span class="live-badge"><span class="pulse"></span>Live · Auto-refresh 30s</span>
            <span id="lastUpdate" style="opacity: 0.7;"></span>
          </p>
        </div>
        <div style="position: relative; z-index: 1;">
          <button class="btn-refresh" id="refreshBtn" onclick="loadMyVMs()">
            <svg class="icon"><use href="#i-refresh"/></svg>
            Refresh
          </button>
        </div>
      </div>

      <!-- Stats -->
      <div class="stats-enhanced">
        <div class="stat-card-enhanced" style="--accent-color: var(--color-indigo);">
          <div class="stat-header">
            <div class="stat-icon-box"><svg class="icon"><use href="#i-server"/></svg></div>
            <span class="stat-trend"><svg class="icon" style="font-size:9px"><use href="#i-trend"/></svg> Total</span>
          </div>
          <div class="stat-value-enhanced" id="myTotal">—</div>
          <div class="stat-label-enhanced">My VMs</div>
        </div>
        <div class="stat-card-enhanced" style="--accent-color: var(--color-emerald);">
          <div class="stat-header">
            <div class="stat-icon-box"><svg class="icon"><use href="#i-play"/></svg></div>
            <span class="stat-trend">Active</span>
          </div>
          <div class="stat-value-enhanced" id="myRunning">—</div>
          <div class="stat-label-enhanced">Running</div>
        </div>
        <div class="stat-card-enhanced" style="--accent-color: var(--color-gray);">
          <div class="stat-header">
            <div class="stat-icon-box"><svg class="icon"><use href="#i-stop"/></svg></div>
            <span class="stat-trend" style="background: var(--color-gray-light); color: var(--color-gray);">Idle</span>
          </div>
          <div class="stat-value-enhanced" id="myStopped">—</div>
          <div class="stat-label-enhanced">Stopped</div>
        </div>
        <div class="stat-card-enhanced" style="--accent-color: var(--color-cyan);">
          <div class="stat-header">
            <div class="stat-icon-box"><svg class="icon"><use href="#i-mem"/></svg></div>
            <span class="stat-trend" style="background: var(--color-cyan-light); color: var(--color-cyan);">Alloc</span>
          </div>
          <div class="stat-value-enhanced" id="myTotalMem">—</div>
          <div class="stat-label-enhanced">Total RAM</div>
        </div>
      </div>

      <!-- VMs Grid -->
      <div id="myVMContainer">
        <div class="vm-grid">
          <div class="skeleton-card"></div>
          <div class="skeleton-card"></div>
          <div class="skeleton-card"></div>
        </div>
      </div>

    </div>

    <%- include('../partials/admin/footer') %>
  </div>
</div>

<script>
function formatMem(mem) {
  if (!mem) return '—';
  return mem >= 1024 ? (mem / 1024).toFixed(1) + ' GB' : mem + ' MB';
}

function formatTime() {
  const d = new Date();
  return d.toLocaleTimeString('en-US', { hour: '2-digit', minute: '2-digit', second: '2-digit' });
}

async function loadMyVMs() {
  const btn = document.getElementById('refreshBtn');
  btn.classList.add('spinning');
  
  try {
    const res = await fetch('/api/vms');
    if (!res.ok) throw new Error('Failed to load VMs');
    const vms = await res.json();
    
    const total = vms.length;
    const running = vms.filter(v => v.status === 'running').length;
    const stopped = vms.filter(v => v.status === 'stopped').length;
    const totalMem = vms.reduce((s, v) => s + (v.memory || 0), 0);
    
    animateNumber('myTotal', total);
    animateNumber('myRunning', running);
    animateNumber('myStopped', stopped);
    document.getElementById('myTotalMem').textContent = formatMem(totalMem);
    document.getElementById('lastUpdate').textContent = `· Updated ${formatTime()}`;
    
    const container = document.getElementById('myVMContainer');
    
    if (vms.length === 0) {
      container.innerHTML = `
        <div class="empty-enhanced">
          <div class="empty-icon-wrap"><svg class="icon"><use href="#i-server"/></svg></div>
          <div class="empty-title">No Virtual Machines Yet</div>
          <div class="empty-desc">You don't have any VMs assigned to your account. Please contact your administrator to provision virtual machines.</div>
          <button class="btn-refresh" onclick="loadMyVMs()">
            <svg class="icon"><use href="#i-refresh"/></svg> Check Again
          </button>
        </div>`;
      return;
    }
    
    container.innerHTML = `
      <div class="vm-grid">
        ${vms.map(vm => renderVMCard(vm)).join('')}
      </div>`;
      
  } catch(e) {
    document.getElementById('myVMContainer').innerHTML = `
      <div class="empty-enhanced">
        <div class="empty-icon-wrap" style="color: var(--color-red); background: linear-gradient(135deg, var(--color-red-light), rgba(239,68,68,0.05));">
          <svg class="icon"><use href="#i-alert"/></svg>
        </div>
        <div class="empty-title">Failed to Load VMs</div>
        <div class="empty-desc">${escHtml(e.message)}</div>
        <button class="btn-refresh" onclick="loadMyVMs()">
          <svg class="icon"><use href="#i-refresh"/></svg> Try Again
        </button>
      </div>`;
  } finally {
    setTimeout(() => btn.classList.remove('spinning'), 500);
  }
}

function renderVMCard(vm) {
  const icon = vm.template_icon;
  const displayIcon = (icon && icon.startsWith('http')) ? icon : 'https://i.imgur.com/wu0Ob6B.png';
  const status = vm.status || 'stopped';
  const sshPort = vm.ssh_port || vm.ssh_port_static;
  
  return `
    <div class="vm-card-enhanced ${status}">
      <div class="vm-card-header">
        <div class="vm-title-block">
          <div class="vm-os-icon">
            <img src="${displayIcon}" alt="${escHtml(vm.template_name || 'OS')}" onerror="this.src='https://i.imgur.com/wu0Ob6B.png'">
          </div>
          <div style="min-width: 0; flex: 1;">
            <div class="vm-name-enhanced">${escHtml(vm.vm_name)}</div>
            <div class="vm-meta-enhanced">
              <span>${escHtml(vm.template_name || vm.os_type || 'Custom OS')}</span>
              <span class="vm-id-chip">#${vm.vm_id}</span>
            </div>
          </div>
        </div>
        <span class="status-badge ${status}">
          <span class="status-dot"></span>${status}
        </span>
      </div>

      <div class="vm-specs">
        <div class="spec-item">
          <div class="spec-icon mem"><svg class="icon"><use href="#i-mem"/></svg></div>
          <div class="spec-content">
            <div class="spec-label">Memory</div>
            <div class="spec-value">${vm.memory ? vm.memory + ' MB' : '—'}</div>
          </div>
        </div>
        <div class="spec-item">
          <div class="spec-icon cpu"><svg class="icon"><use href="#i-cpu"/></svg></div>
          <div class="spec-content">
            <div class="spec-label">vCPUs</div>
            <div class="spec-value">${vm.cpus || '—'} Cores</div>
          </div>
        </div>
        <div class="spec-item">
          <div class="spec-icon disk"><svg class="icon"><use href="#i-disk"/></svg></div>
          <div class="spec-content">
            <div class="spec-label">Storage</div>
            <div class="spec-value">${vm.disk_size || '—'}</div>
          </div>
        </div>
        <div class="spec-item">
          <div class="spec-icon net"><svg class="icon"><use href="#i-network"/></svg></div>
          <div class="spec-content">
            <div class="spec-label">Network</div>
            <div class="spec-value">${vm.ipv4_address || 'DHCP'}</div>
          </div>
        </div>
      </div>

      ${sshPort ? `
      <div class="ssh-info-box">
        <div class="ssh-icon-wrap"><svg class="icon"><use href="#i-terminal"/></svg></div>
        <div class="ssh-details">
          <strong>${escHtml(vm.username || 'root')}</strong>@localhost:<strong>${sshPort}</strong>
        </div>
        <button class="ssh-copy-btn" onclick="copySSH('ssh ${escHtml(vm.username || 'root')}@localhost -p ${sshPort}')" title="Copy SSH command">
          <svg class="icon"><use href="#i-copy"/></svg>
        </button>
      </div>` : ''}

      <div class="vm-actions-enhanced">
        ${status === 'stopped'
          ? `<button class="btn-action start" onclick="vmAction('start', ${vm.vm_id}, '${escHtml(vm.vm_name)}')">
              <svg class="icon"><use href="#i-play"/></svg> Start
            </button>`
          : `<button class="btn-action stop" onclick="vmAction('stop', ${vm.vm_id}, '${escHtml(vm.vm_name)}')">
              <svg class="icon"><use href="#i-stop"/></svg> Stop
            </button>`
        }
        <a href="/vm/${vm.vm_id}" class="btn-action primary">
          <svg class="icon"><use href="#i-info"/></svg> Details
        </a>
        <a href="/vm/${vm.vm_id}/console" class="btn-action">
          <svg class="icon"><use href="#i-terminal"/></svg> Console
        </a>
      </div>
    </div>
  `;
}

function animateNumber(id, target) {
  const el = document.getElementById(id);
  if (!el) return;
  const current = parseInt(el.textContent) || 0;
  const duration = 600;
  const start = performance.now();
  function step(now) {
    const p = Math.min((now - start) / duration, 1);
    const eased = 1 - Math.pow(1 - p, 3);
    el.textContent = Math.round(current + (target - current) * eased);
    if (p < 1) requestAnimationFrame(step);
  }
  requestAnimationFrame(step);
}

function copySSH(cmd) {
  navigator.clipboard.writeText(cmd).then(() => {
    showToast('SSH command copied to clipboard', 'success');
  }).catch(() => showToast('Failed to copy', 'error'));
}

async function vmAction(action, vmId, vmName) {
  const confirmed = await confirmAction(
    `Are you sure you want to ${action} VM "${vmName}"?`,
    action.charAt(0).toUpperCase() + action.slice(1) + ' Virtual Machine'
  );
  if (!confirmed) return;
  
  try {
    showToast(`${action.charAt(0).toUpperCase() + action.slice(1)}ing VM...`, 'info');
    const res = await fetch(`/api/vms/${vmId}/${action}`, { method: 'POST' });
    const data = await res.json();
    if (res.ok && data.success) {
      showToast(`VM ${action}ed successfully`, 'success');
      setTimeout(loadMyVMs, 1200);
    } else {
      showToast(`Failed: ${data.error || 'Unknown error'}`, 'error');
    }
  } catch(e) {
    showToast('Error: ' + e.message, 'error');
  }
}

function escHtml(str) {
  if (!str) return '';
  return String(str).replace(/[&<>"']/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));
}

function showToast(msg, type = 'info') {
  const container = document.getElementById('toastContainer') || createToastContainer();
  const iconMap = { success: 'i-check', error: 'i-x', warning: 'i-alert', info: 'i-info' };
  
  const toast = document.createElement('div');
  toast.className = `toast toast-${type}`;
  toast.innerHTML = `
    <span class="toast-icon"><svg class="icon" style="width:18px;height:18px"><use href="#${iconMap[type] || 'i-info'}"/></svg></span>
    <span class="toast-message">${escHtml(msg)}</span>
    <button class="toast-close" onclick="this.parentElement.remove()">×</button>
  `;
  container.appendChild(toast);
  
  setTimeout(() => {
    toast.classList.add('removing');
    setTimeout(() => toast.remove(), 300);
  }, 4000);
}

function createToastContainer() {
  const container = document.createElement('div');
  container.id = 'toastContainer';
  container.className = 'toast-container';
  document.body.appendChild(container);
  return container;
}

function confirmAction(msg, title) {
  return new Promise((resolve) => {
    const overlay = document.createElement('div');
    overlay.style.cssText = 'position:fixed;inset:0;background:rgba(0,0,0,0.75);z-index:2000;display:flex;align-items:center;justify-content:center;padding:20px;backdrop-filter:blur(8px);';
    
    const modal = document.createElement('div');
    modal.style.cssText = 'background:var(--bg-card);border:1px solid var(--border-card);border-radius:14px;width:100%;max-width:450px;box-shadow:0 20px 60px rgba(0,0,0,0.6);animation:slideInModal 0.3s ease-out;overflow:hidden;';
    
    modal.innerHTML = `
      <div style="padding:20px 22px 14px;border-bottom:1px solid var(--border-subtle);display:flex;align-items:center;gap:12px;">
        <div style="width:38px;height:38px;background:rgba(245,158,11,0.15);border-radius:10px;display:flex;align-items:center;justify-content:center;color:#F59E0B;">
          <svg class="icon" style="width:20px;height:20px;"><use href="#i-alert"/></svg>
        </div>
        <h2 style="margin:0;color:var(--text-primary);font-size:16px;font-weight:700;">${escHtml(title)}</h2>
      </div>
      <div style="padding:20px 22px;">
        <p style="margin:0;color:var(--text-secondary);font-size:14px;line-height:1.5;">${escHtml(msg)}</p>
