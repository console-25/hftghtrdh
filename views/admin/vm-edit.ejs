 ''}`;
  })
  .catch(() => {
    window.location.href = '/vms';
  });

// Connect WebSocket
function connectWS() {
  const wsUrl = `${location.protocol === 'https:' ? 'wss' : 'ws'}://${location.host}/console/${vmId}`;
  updateWSStatus('connecting');
  
  try {
    ws = new WebSocket(wsUrl);
    ws.binaryType = 'arraybuffer';
    
    ws.onopen = () => {
      updateWSStatus('connected');
      appendOutput('\r\n\x1b[32m✓ WebSocket connected\x1b[0m\r\n');
    };
    
    ws.onmessage = (event) => {
      try {
        const msg = JSON.parse(event.data);
        if (msg.type === 'output' && msg.data) {
          appendOutput(msg.data);
        }
      } catch(e) {
        if (typeof event.data === 'string') {
          appendOutput(event.data);
        }
      }
    };
    
    ws.onclose = () => {
      updateWSStatus('disconnected');
      appendOutput('\r\n\x1b[31m✗ Connection closed\x1b[0m\r\n');
      // Auto-reconnect after 3s
      setTimeout(connectWS, 3000);
    };
    
    ws.onerror = () => {
      updateWSStatus('error');
      appendOutput('\r\n\x1b[31m✗ WebSocket error\x1b[0m\r\n');
    };
  } catch(e) {
    updateWSStatus('error');
    appendOutput(`\r\n\x1b[31m✗ Connection error: ${e.message}\x1b[0m\r\n`);
    setTimeout(connectWS, 3000);
  }
}

function updateWSStatus(state) {
  const el = document.getElementById('wsStatus');
  if (!el) return;
  const states = {
    connecting: { text: '🟡 Connecting...', style: 'background: rgba(245, 158, 11, 0.15); color: #fbbf24;' },
    connected: { text: '🟢 Connected', style: 'background: rgba(16, 185, 129, 0.15); color: #34d399;' },
    disconnected: { text: '⚫ Disconnected', style: 'background: rgba(100, 116, 139, 0.15); color: #94a3b8;' },
    error: { text: '🔴 Error', style: 'background: rgba(239, 68, 68, 0.15); color: #f87171;' }
  };
  const s = states[state] || states.disconnected;
  el.textContent = s.text;
  el.style.cssText = `margin-left: auto; font-size: 11px; padding: 3px 8px; border-radius: 4px; flex-shrink: 0; ${s.style}`;
}

// ANSI color escape code parser
function parseAnsi(text) {
  return text
    .replace(/\x1b\[32m/g, '<span class="ansi-green">')
    .replace(/\x1b\[31m/g, '<span class="ansi-red">')
    .replace(/\x1b\[33m/g, '<span class="ansi-yellow">')
    .replace(/\x1b\[34m/g, '<span class="ansi-blue">')
    .replace(/\x1b\[36m/g, '<span class="ansi-cyan">')
    .replace(/\x1b\[37m/g, '<span class="ansi-white">')
    .replace(/\x1b\[0m/g, '</span>')
    .replace(/\x1b\[1m/g, '<span class="ansi-bold">')
    .replace(/\x1b\[\d+m/g, '')
    .replace(/\x1b\[\d+;\d+m/g, '')
    .replace(/\x1b\[\d+;\d+;\d+m/g, '')
    .replace(/\x1b\[[\d;]*[A-Za-z]/g, '');
}

function appendOutput(text) {
  const terminal = document.getElementById('terminal');
  if (!terminal) return;
  
  const parsed = parseAnsi(escTerminal(text));
  const span = document.createElement('span');
  span.innerHTML = parsed;
  terminal.appendChild(span);
  
  if (autoScroll) {
    terminal.scrollTop = terminal.scrollHeight;
  }
  
  const children = terminal.children;
  if (children.length > 5000) {
    terminal.removeChild(children[0]);
  }
}

function escTerminal(str) {
  return str
    .replace(/&/g, '&amp;')
    .replace(/</g, '&lt;')
    .replace(/>/g, '&gt;')
    .replace(/\r\n/g, '\n')
    .replace(/\n/g, '<br>');
}

function clearTerminal() {
  const terminal = document.getElementById('terminal');
  terminal.innerHTML = '';
  appendOutput('\x1b[36m[Console cleared]\x1b[0m\r\n');
}

function scrollToBottom() {
  const terminal = document.getElementById('terminal');
  terminal.scrollTop = terminal.scrollHeight;
  autoScroll = true;
}

function toggleWrap() {
  const terminal = document.getElementById('terminal');
  const btn = document.getElementById('wrapBtn');
  wordWrap = !wordWrap;
  terminal.style.whiteSpace = wordWrap ? 'pre-wrap' : 'pre';
  terminal.style.wordBreak = wordWrap ? 'break-all' : 'normal';
  btn.style.color = wordWrap ? '#818cf8' : 'var(--text-muted)';
}

document.getElementById('terminal').addEventListener('scroll', function() {
  const el = this;
  autoScroll = el.scrollTop + el.clientHeight >= el.scrollHeight - 10;
});

function sendCommand() {
  const input = document.getElementById('cmdInput');
  const cmd = input.value;
  
  if (!cmd.trim() && cmd !== '') return;
  
  if (cmd.trim()) {
    commandHistory.unshift(cmd);
    if (commandHistory.length > 100) commandHistory.pop();
    historyIndex = -1;
  }
  
  appendOutput(`\r\n<span class="ansi-green">vm@${vmId}:~$</span> ${escTerminal(cmd)}\r\n`);
  
  if (ws && ws.readyState === WebSocket.OPEN) {
    ws.send(JSON.stringify({ type: 'input', data: cmd + '\n' }));
  } else {
    fetch(`/api/vms/${vmId}/console/command`, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ command: cmd })
    }).catch(() => {});
  }
  
  input.value = '';
}

document.getElementById('cmdInput').addEventListener('keydown', (e) => {
  if (e.key === 'Enter') {
    sendCommand();
  } else if (e.key === 'ArrowUp') {
    e.preventDefault();
    historyIndex = Math.min(historyIndex + 1, commandHistory.length - 1);
    if (commandHistory[historyIndex]) {
      document.getElementById('cmdInput').value = commandHistory[historyIndex];
    }
  } else if (e.key === 'ArrowDown') {
    e.preventDefault();
    historyIndex = Math.max(historyIndex - 1, -1);
    document.getElementById('cmdInput').value = historyIndex >= 0 ? (commandHistory[historyIndex] || '') : '';
  } else if (e.key === 'l' && e.ctrlKey) {
    e.preventDefault();
    clearTerminal();
  }
});

connectWS();
document.getElementById('cmdInput').focus();

setTimeout(() => {
  const t = document.getElementById('terminal');
  if (t) t.scrollTop = t.scrollHeight;
}, 500);
</script>
</body>
</html>


