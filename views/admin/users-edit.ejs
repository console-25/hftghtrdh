          </button>
          <a href="/admin/vm-create" class="btn btn-primary btn-sm">
            <svg width="13" height="13"><use href="#i-plus"/></svg>
            New VM
          </a>
        </div>
      </div>

      <!-- VM Stats Row (clickable to filter) -->
      <div class="stats-grid" style="grid-template-columns: repeat(4, 1fr); margin-bottom: 16px;">
        <div class="stat-card stat-clickable" style="--card-gradient: var(--gradient-primary); padding: 14px; cursor:pointer;" data-filter="" onclick="quickFilter('')">
          <div style="display: flex; align-items: center; justify-content: space-between;">
            <div>
              <div class="stat-value" style="font-size: 22px;" id="totalCount">—</div>
              <div class="stat-label">Total</div>
            </div>
            <div class="stat-icon-svg" style="color: #6366F1;"><svg width="24" height="24"><use href="#i-server"/></svg></div>
          </div>
        </div>
        <div class="stat-card stat-clickable" style="--card-gradient: var(--gradient-green); padding: 14px; cursor:pointer;" data-filter="running" onclick="quickFilter('running')">
          <div style="display: flex; align-items: center; justify-content: space-between;">
            <div>
              <div class="stat-value" style="font-size: 22px; color: var(--accent-green);" id="runningCount">—</div>
              <div class="stat-label">Running</div>
            </div>
            <div class="stat-icon-svg" style="color: #10B981;"><svg width="24" height="24"><use href="#i-play"/></svg></div>
