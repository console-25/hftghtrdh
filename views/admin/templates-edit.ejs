">${svg(iconId, 11)} [${log.action?.toUpperCase() || 'LOG'}]</span>
              <span style="color: #e2e8f0; flex:1; min-width:200px;">${escHtml(log.message || '')}</span>
            </div>
          `;
          }).join('')}
          <span class="terminal-cursor"></span>
        </div>
      </div>`;
  } catch(e) {
    el.innerHTML = `<div style="color: var(--text-muted); font-size: 13px; text-align: center; padding: 20px;">Could not load logs</div>`;
  }
}

function copySSH() {
  const cmd = document.getElementById('sshCmd')?.textContent;
  if (cmd) {
    navigator.clipboard.writeText(cmd).then(() => showToast('SSH command copied to clipboard', 'success'));
  }
}

function escHtml(str) {
  if (!str) return '—';
  return String(str).replace(/[&<>"']/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));
}

function openModal(id) {
  const m = document.getElementById(id);
  if (m) m.classList.add('show');
}

function closeModal(id) {
  const m = document.getElementById(id);
  if (m) m.classList.remove('show');
}

function showToast(msg, type = 'info') {
  let container = document.getElementById('toastContainer');
  if (!container) {
    container = document.createElement('div');
    container.id = 'toastContainer';
    container.className = 'toast-container';
    document.body.appendChild(container);
  }
  const iconMap = { success: 'i-check', error: 'i-x', warning: 'i-alert', info: 'i-info' };
  const toast = document.createElement('div');
  toast.className = `toast toast-${type}`;
  toast.innerHTML = `<span class="toast-icon">${svg(iconMap[type] || 'i-info', 16)}</span><span class="toast-message">${escHtml(msg)}</span><button class="toast-close" onclick="this.parentElement.remove()">×</button>`;
  container.appendChild(toast);
  setTimeout(() => { toast.classList.add('removing'); setTimeout(() => toast.remove(), 300); }, 4500);
}

function confirmAction(msg, title, variant = 'warning') {
  return new Promise((resolve) => {
    const isDanger = variant === 'danger';
    const overlay = document.createElement('div');
    overlay.style.cssText = 'position:fixed;inset:0;background:rgba(0,0,0,0.75);z-index:2000;display:flex;align-items:center;justify-content:center;padding:20px;backdrop-filter:blur(8px);';
    
    const modal = document.createElement('div');
    modal.style.cssText = 'background:var(--bg-card);border:1px solid var(--border-card);border-radius:var(--radius-lg);width:100%;max-width:460px;box-shadow:0 20px 60px rgba(0,0,0,0.6);animation:slideInModal 0.35s ease-out;overflow:hidden;';
    
    const iconColor = isDanger ? '#EF4444' : '#F59E0B';
    const iconBg = isDanger ? 'rgba(239,68,68,0.12)' : 'rgba(245,158,11,0.12)';
    const btnGrad = isDanger ? 'linear-gradient(135deg,#ef4444,#dc2626)' : 'linear-gradient(135deg,#f59e0b,#f97316)';
    const btnShadow = isDanger ? 'rgba(239,68,68,0.3)' : 'rgba(245,158,11,0.3)';
    
    modal.innerHTML = `
      <div style="padding:20px 22px 14px;border-bottom:1px solid var(--border-subtle);display:flex;align-items:center;gap:12px;">
        <div style="width:40px;height:40px;background:${iconBg};border-radius:10px;display:flex;align-items:center;justify-content:center;color:${iconColor};">
          ${svg(isDanger ? 'i-alert' : 'i-alert', 22)}
        </div>
        <h2 style="margin:0;color:var(--text-primary);font-size:16px;font-weight:700;">${escHtml(title)}</h2>
      </div>
      <div style="padding:20px 22px;">
        <p style="margin:0;color:var(--text-secondary);font-size:14px;line-height:1.5;">${escHtml(msg)}</p>
      </div>
      <div style="padding:14px 22px 18px;border-top:1px solid var(--border-subtle);display:flex;gap:10px;justify-content:flex-end;">
        <button id="cancelBtn" style="padding:9px 18px;border-radius:var(--radius-sm);cursor:pointer;font-weight:600;font-size:13px;background:transparent;color:var(--text-secondary);border:1px solid var(--border-color);">Cancel</button>
        <button id="confirmBtn" style="padding:9px 18px;border-radius:var(--radius-sm);cursor:pointer;border:none;font-weight:600;font-size:13px;background:${btnGrad};color:white;box-shadow:0 4px 12px ${btnShadow};">Confirm</button>
      </div>
    `;
    overlay.appendChild(modal);
    document.body.appendChild(overlay);
    
    const cleanup = () => overlay.remove();
    modal.querySelector('#confirmBtn').onclick = () => { cleanup(); resolve(true); };
    modal.querySelector('#cancelBtn').onclick = () => { cleanup(); resolve(false); };
    overlay.onclick = (e) => { if (e.target === overlay) { cleanup(); resolve(false); } };
    document.addEventListener('keydown', function esc(e) {
      if (e.key === 'Escape') { cleanup(); resolve(false); document.removeEventListener('keydown', esc); }
    });
  });
}

// Reinstall Functions
async function loadTemplatesForReinstall() {
  try {
    const res = await fetch('/api/admin/templates');
    if (!res.ok) throw new Error('Failed to load templates');
    
    const templates = await res.json();
    const select = document.getElementById('reinstall_template');
    if (!select) return;
    
    select.innerHTML = '<option value="">— Choose Template —</option>';
    
    const builtIn = {
      'ubuntu_22_cloud': 'Ubuntu 22.04 LTS (Cloud)',
      'ubuntu_24_cloud': 'Ubuntu 24.04 LTS (Cloud)',
      'debian_12_cloud': 'Debian 12 (Cloud)',
      'fedora_40_cloud': 'Fedora 40 (Cloud)',
      'centos_9_cloud': 'CentOS 9 Stream (Cloud)',
      'almalinux_9_cloud': 'AlmaLinux 9 (Cloud)'
    };
    
    Object.entries(builtIn).forEach(([key, name]) => {
      const opt = document.createElement('option');
      opt.value = key;
      opt.textContent = name;
      select.appendChild(opt);
    });
    
    if (templates && templates.custom && Array.isArray(templates.custom) && templates.custom.length > 0) {
      const optgroup = document.createElement('optgroup');
      optgroup.label = '--- Custom Templates ---';
      templates.custom.forEach(t => {
        const opt = document.createElement('option');
        opt.value = t.template_key;
        opt.textContent = `${t.template_name} (Custom)`;
        optgroup.appendChild(opt);
      });
      select.appendChild(optgroup);
    }
  } catch (e) {
    console.error('Failed to load templates:', e.message);
    showToast('Failed to load templates', 'error');
  }
}

async function performReinstall(e) {
  e.preventDefault();
  
  const btn = document.getElementById('confirmReinstallBtn');
  
  btn.disabled = true;
  btn.innerHTML = `<span class="spinner spinner-sm" style="margin-right:6px;"></span> Reinstalling...`;
  
  try {
    const form = document.getElementById('reinstallForm');
    const fd = new FormData(form);
    const data = {
      new_os_template: fd.get('new_os_template'),
      new_username: fd.get('new_username') || undefined,
      new_password: fd.get('new_password') || undefined,
      confirm: fd.get('confirm') === 'on'
    };
    
    if (!data.new_os_template) throw new Error('Please select an OS template');
    if (!data.confirm) throw new Error('Please confirm the reinstall');
    
    const res = await fetch(`/api/vms/${vmId}/reinstall`, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(data)
    });
    
    const result = await res.json();
    
    if (res.ok && result.success) {
      showToast(result.message || 'VM reinstall started', 'success');
      closeModal('reinstallModal');
      setTimeout(() => loadVM(), 1500);
    } else {
      throw new Error(result.error || 'Reinstall failed');
    }
  } catch (e) {
    showToast('Reinstall error: ' + e.message, 'error');
    btn.innerHTML = `${svg('i-refresh', 14)} Reinstall`;
    btn.disabled = false;
  }
}

// ISO Management
async function loadISOStatus() {
  try {
    const res = await fetch(`/api/vms/${vmId}/iso/status`);
    if (!res.ok) return;
    
    const data = await res.json();
    const section = document.getElementById('isoManagementSection');
    const statusDiv = document.getElementById('isoStatus');
    const infoDiv = document.getElementById('isoInfo');
    const attachBtn = document.getElementById('attachISOBtn');
    const detachBtn = document.getElementById('detachISOBtn');
    
    if (!section) return;
    
    if (vmData && vmData.template_type === 'iso') {
      section.style.display = 'block';
      
      if (data.iso_attached) {
        statusDiv.textContent = `ISO Attached: ${data.iso_attached}`;
        infoDiv.innerHTML = `
          <div style="margin-bottom: 6px; display:inline-flex; align-items:center; gap:6px;">
            <span style="color:#06B6D4;">${svg('i-disc', 13)}</span>
            <strong>Current ISO:</strong> ${escHtml(data.iso_attached)}
          </div>
          <div style="font-size: 11px; color: var(--text-muted); display:inline-flex; align-items:center; gap:6px;">
            <span>${svg('i-power', 11)}</span> Boot Mode: ${data.boot_from_iso ? 'Boot from ISO' : 'Boot from Disk'} · 
            VM Status: ${data.vm_status ? data.vm_status.toUpperCase() : 'Unknown'}
          </div>
        `;
        attachBtn.style.display = 'none';
        detachBtn.style.display = 'inline-flex';
      } else {
        statusDiv.textContent = 'No ISO Attached';
        infoDiv.innerHTML = `
          <div style="color: var(--text-muted); font-size: 12px;">
            Attach an ISO file to boot from it. After installation, detach to boot from disk.
          </div>
        `;
        attachBtn.style.display = 'inline-flex';
        detachBtn.style.display = 'none';
      }
    } else {
      section.style.display = 'none';
    }
  } catch (e) {
    console.error('Failed to load ISO status:', e);
  }
}

async function loadISOFiles() {
  try {
    const res = await fetch('/api/iso-list');
    if (!res.ok) throw new Error('Failed to load ISOs');
    
    const files = await res.json();
    const select = document.getElementById('isoFileSelect');
    if (!select) return;
    
    select.innerHTML = '<option value="">— Select ISO file —</option>';
    if (files.length === 0) {
      select.innerHTML = '<option value="">No ISO files available</option>';
      select.disabled = true;
      return;
    }
    
    files.forEach(file => {
      const opt = document.createElement('option');
      opt.value = file;
      opt.textContent = file;
      select.appendChild(opt);
    });
  } catch (e) {
    console.error('Failed to load ISO files:', e);
    showToast('Failed to load ISO files', 'error');
  }
}

function openISOAttachModal() {
  loadISOFiles();
  openModal('isoAttachModal');
}

async function performISOAttach() {
  const select = document.getElementById('isoFileSelect');
  const isoFile = select.value;
  
  if (!isoFile) {
    showToast('Please select an ISO file', 'warning');
    return;
  }
  
  try {
    showToast('Attaching ISO...', 'info');
    const res = await fetch(`/api/vms/${vmId}/iso/attach`, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ iso_file: isoFile })
    });
    
    const data = await res.json();
    
    if (res.ok && data.success) {
      showToast(data.message || 'ISO attached successfully', 'success');
      closeModal('isoAttachModal');
      loadISOStatus();
    } else {
      throw new Error(data.error || 'Failed to attach ISO');
    }
  } catch (e) {
    showToast('ISO attach failed: ' + e.message, 'error');
  }
}

async function detachISO() {
  const confirmed = await confirmAction('Detach the ISO and boot from disk on next start?', 'Detach ISO');
  if (!confirmed) return;
  
  try {
    showToast('Detaching ISO...', 'info');
    const res = await fetch(`/api/vms/${vmId}/iso/detach`, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' }
    });
    
    const data = await res.json();
    
    if (res.ok && data.success) {
      showToast(data.message || 'ISO detached successfully', 'success');
      loadISOStatus();
    } else {
      throw new Error(data.error || 'Failed to detach ISO');
    }
  } catch (e) {
    showToast('ISO detach failed: ' + e.message, 'error');
  }
}

// Init
loadVM();
</script>
</body>
