    /* xterm.js customization */
    .terminal-wrapper {
      flex: 1;
      overflow: hidden;
      background: #0a0a0f;
    }
    
    .terminal-wrapper .xterm {
      height: 100%;
      padding: 10px;
    }
    
    /* Modal Styles */
    .modal-backdrop {
      display: none;
