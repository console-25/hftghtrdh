    .spec-icon-mini.disk { background: rgba(6, 182, 212, 0.12); color: #06B6D4; }
    .spec-icon-mini.net { background: rgba(59, 130, 246, 0.12); color: #3B82F6; }
    .spec-content {
      display: flex;
      flex-direction: column;
      min-width: 0;
      flex: 1;
    }
    .spec-label {
      font-size: 9px;
      color: var(--text-muted);
      text-transform: uppercase;
      letter-spacing: 0.5px;
      line-height: 1;
      margin-bottom: 2px;
    }
    .spec-value {
      font-size: 12px;
      color: var(--text-primary);
      font-weight: 600;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }

