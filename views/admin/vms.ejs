    }
    @keyframes pulse-live {
      0%, 100% { opacity: 1; box-shadow: 0 0 0 0 rgba(16, 185, 129, 0.6); }
      50% { opacity: 0.6; box-shadow: 0 0 0 6px rgba(16, 185, 129, 0); }
    }

    /* ============ STATS ============ */
    .stats-enhanced {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 14px;
      margin-bottom: 20px;
    }
    .stat-card-enhanced {
      background: var(--bg-card);
      border: 1px solid var(--border-card);
      border-radius: 12px;
      padding: 16px;
      position: relative;
      overflow: hidden;
      transition: all 0.3s ease;
      cursor: pointer;
    }
    .stat-card-enhanced::before {
      content: '';
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      height: 3px;
      background: var(--accent-color, #6366F1);
    }
    .stat-card-enhanced:hover {
      transform: translateY(-3px);
      border-color: var(--accent-color, #6366F1);
      box-shadow: 0 12px 32px rgba(0, 0, 0, 0.3);
    }
    .stat-card-enhanced.active {
      border-color: var(--accent-color, #6366F1);
      background: color-mix(in srgb, var(--accent-color, #6366F1) 6%, var(--bg-card));
    }
    .stat-inner {
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 12px;
    }
    .stat-icon-box {
      width: 42px;
      height: 42px;
      display: flex;
      align-items: center;
      justify-content: center;
      border-radius: 10px;
      font-size: 20px;
      background: color-mix(in srgb, var(--accent-color, #6366F1) 15%, transparent);
      color: var(--accent-color, #6366F1);
      flex-shrink: 0;
    }
    .stat-value-enhanced {
      font-size: 24px;
      font-weight: 700;
      color: var(--text-primary);
      line-height: 1;
      margin-bottom: 4px;
    }
    .stat-label-enhanced {
      font-size: 11px;
      color: var(--text-muted);
      font-weight: 500;
      text-transform: uppercase;
      letter-spacing: 0.5px;
    }

    /* ============ FILTER BAR ============ */
    .filter-bar-enhanced {
      display: flex;
      gap: 10px;
      align-items: center;
      margin-bottom: 20px;
      padding: 12px;
      background: var(--bg-card);
      border: 1px solid var(--border-card);
      border-radius: 12px;
      flex-wrap: wrap;
    }
    .search-wrap {
      position: relative;
      flex: 1;
      min-width: 220px;
      max-width: 320px;
    }
    .search-wrap .search-icon-svg {
      position: absolute;
      top: 50%;
      left: 12px;
      transform: translateY(-50%);
      color: var(--text-muted);
      pointer-events: none;
      width: 15px;
      height: 15px;
    }
    .search-input {
      width: 100%;
      padding: 9px 12px 9px 36px;
      background: rgba(255, 255, 255, 0.03);
      border: 1px solid var(--border-color);
      border-radius: 8px;
      color: var(--text-primary);
      font-size: 13px;
      transition: all 0.2s;
    }
    .search-input:focus {
      outline: none;
      border-color: #6366F1;
      background: rgba(99, 102, 241, 0.05);
      box-shadow: 0 0 0 3px rgba(99, 102, 241, 0.1);
    }
    .filter-select {
      padding: 9px 12px;
      background: rgba(255, 255, 255, 0.03);
      border: 1px solid var(--border-color);
      border-radius: 8px;
      color: var(--text-primary);
      font-size: 13px;
      cursor: pointer;
      transition: all 0.2s;
      min-width: 140px;
    }
    .filter-select:hover, .filter-select:focus {
      border-color: #6366F1;
      outline: none;
    }
    .view-switcher {
      display: flex;
      gap: 4px;
      padding: 3px;
      background: rgba(255, 255, 255, 0.03);
      border: 1px solid var(--border-color);
      border-radius: 8px;
      margin-left: auto;
    }
    .view-btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 32px;
      height: 30px;
      background: transparent;
      border: none;
      border-radius: 6px;
      color: var(--text-muted);
      cursor: pointer;
      transition: all 0.2s;
      font-size: 14px;
    }
    .view-btn:hover { color: var(--text-primary); background: rgba(255, 255, 255, 0.04); }
    .view-btn.active {
      background: linear-gradient(135deg, #6366F1, #8B5CF6);
      color: white;
      box-shadow: 0 4px 10px rgba(99, 102, 241, 0.3);
    }

    /* ============ REFRESH BUTTON ============ */
    .btn-refresh {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      padding: 10px 16px;
      background: rgba(99, 102, 241, 0.1);
      border: 1px solid rgba(99, 102, 241, 0.3);
      border-radius: 10px;
      color: #6366F1;
      font-weight: 600;
      font-size: 13px;
      cursor: pointer;
      transition: all 0.2s;
    }
    .btn-refresh:hover {
      background: rgba(99, 102, 241, 0.18);
      transform: translateY(-1px);
    }
    .btn-refresh.spinning svg { animation: spin 0.8s linear infinite; }
    @keyframes spin { to { transform: rotate(360deg); } }

    /* ============ VM GRID CARDS ============ */
    .vm-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(340px, 1fr));
      gap: 18px;
    }
    .vm-card-enhanced {
      background: var(--bg-card);
      border: 1px solid var(--border-card);
      border-radius: 14px;
      padding: 18px;
      transition: all 0.3s ease;
      position: relative;
      overflow: hidden;
      cursor: pointer;
    }
    .vm-card-enhanced::before {
      content: '';
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      height: 3px;
    }
    .vm-card-enhanced.running::before { background: linear-gradient(90deg, #10B981, #06B6D4); }
    .vm-card-enhanced.stopped::before { background: linear-gradient(90deg, #6B7280, #4B5563); }
    .vm-card-enhanced.error::before { background: linear-gradient(90deg, #EF4444, #DC2626); }
    .vm-card-enhanced.paused::before { background: linear-gradient(90deg, #F59E0B, #F97316); }
    .vm-card-enhanced:hover {
      transform: translateY(-4px);
      box-shadow: 0 16px 40px rgba(0, 0, 0, 0.35);
      border-color: rgba(99, 102, 241, 0.4);
    }

    .vm-card-header {
      display: flex;
      justify-content: space-between;
      align-items: flex-start;
      gap: 12px;
      margin-bottom: 14px;
    }
    .vm-title-block {
      display: flex;
      align-items: center;
      gap: 12px;
      min-width: 0;
      flex: 1;
    }
    .vm-os-icon {
      width: 42px;
      height: 42px;
      border-radius: 10px;
      background: linear-gradient(135deg, rgba(99, 102, 241, 0.15), rgba(139, 92, 246, 0.08));
      border: 1px solid rgba(99, 102, 241, 0.2);
      display: flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
      overflow: hidden;
      padding: 6px;
    }
    .vm-os-icon img {
      width: 100%;
      height: 100%;
      object-fit: contain;
    }
    .vm-name-enhanced {
      font-size: 15px;
      font-weight: 700;
      color: var(--text-primary);
      margin: 0 0 3px 0;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }
    .vm-meta-enhanced {
      font-size: 11px;
      color: var(--text-muted);
      display: flex;
      align-items: center;
      gap: 6px;
    }
    .vm-id-chip {
      background: rgba(99, 102, 241, 0.1);
      color: #6366F1;
      padding: 1px 7px;
      border-radius: 6px;
      font-family: 'SF Mono', monospace;
      font-weight: 600;
      font-size: 10px;
    }

    .status-badge {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      padding: 4px 10px;
      border-radius: 20px;
      font-size: 11px;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.4px;
      white-space: nowrap;
    }
    .status-badge.running {
      background: rgba(16, 185, 129, 0.12);
      color: #10B981;
      border: 1px solid rgba(16, 185, 129, 0.3);
    }
    .status-badge.stopped {
      background: rgba(107, 114, 128, 0.12);
      color: #9CA3AF;
      border: 1px solid rgba(107, 114, 128, 0.3);
    }
    .status-badge.error {
      background: rgba(239, 68, 68, 0.12);
      color: #EF4444;
      border: 1px solid rgba(239, 68, 68, 0.3);
    }
    .status-badge.paused {
      background: rgba(245, 158, 11, 0.12);
      color: #F59E0B;
      border: 1px solid rgba(245, 158, 11, 0.3);
    }
    .status-badge .status-dot {
      width: 6px;
      height: 6px;
      border-radius: 50%;
      background: currentColor;
    }
    .status-badge.running .status-dot {
      animation: pulse-live 2s ease-in-out infinite;
