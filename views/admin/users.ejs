"flex:1; max-width: 320px;">
          <svg class="search-icon" width="14" height="14"><use href="#i-search"/></svg>
          <input type="text" class="form-control" id="vmSearch" placeholder="Search by name, ID, OS, or IP..." oninput="filterVMs()" style="padding-left: 36px;">
        </div>
        <select class="form-control" id="statusFilter" onchange="filterVMs()" style="width: 150px;">
          <option value="">All Status</option>
          <option value="running">🟢 Running</option>
          <option value="stopped">⚫ Stopped</option>
          <option value="error">🔴 Error</option>
        </select>
        <div style="display: flex; gap: 6px; margin-left: auto;">
          <button class="btn btn-ghost btn-sm btn-icon" onclick="setView('grid')" id="viewGrid" title="Grid view">
            <svg width="14" height="14"><use href="#i-grid"/></svg>
          </button>
          <button class="btn btn-ghost btn-sm btn-icon" onclick="setView('list')" id="viewList" title="List view">
            <svg width="14" height="14"><use href="#i-list"/></svg>
          </button>
        </div>
      </div>

      <!-- VM Grid/List Container -->
      <div id="vmContainer">
        <div style="text-align: center; padding: 60px;">
          <div class="spinner spinner-lg" style="margin: 0 auto 16px;"></div>
          <div style="color: var(--text-muted); font-size: 14px;">Loading virtual machines...</div>
        </div>
      </div>

    </div>

    <%- include('../partials/admin/footer') %>
  </div>
</div>

<script>
let allVMs = [];
let currentView = 'list';

function formatMem(mem) {
  if (!mem) return '—';
  return mem >= 1024 ? (mem/1024).toFixed(1) + ' GB' : mem + ' MB';
}

function formatTime() {
  return new Date().toLocaleTimeString('en-US', { hour: '2-digit', minute: '2-digit', second: '2-digit' });
}

function getStatusClass(status) {
  return status === 'running' ? 'badge-running' : status === 'error' ? 'badge-error' : 'badge-stopped';
}

// Set view mode
function setView(view) {
  currentView = view;
  document.getElementById('viewGrid').classList.toggle('btn-primary', view === 'grid');
  document.getElementById('viewGrid').classList.toggle('btn-ghost', view !== 'grid');
  document.getElementById('viewList').classList.toggle('btn-primary', view === 'list');
  document.getElementById('viewList').classList.toggle('btn-ghost', view !== 'list');
  renderVMs();
}

// Quick filter from stat card
function quickFilter(status) {
  document.getElementById('statusFilter').value = status;
  document.querySelectorAll('.stat-clickable').forEach(c => {
    c.classList.toggle('is-active', c.dataset.filter === status);
  });
  renderVMs();
}

// Animate number counter
function animateNumber(id, target) {
  const el = document.getElementById(id);
  if (!el) return;
  const current = parseInt(el.textContent) || 0;
  const duration = 600;
  const start = performance.now();
  function step(now) {
    const p = Math.min((now - start)/duration, 1);
    const eased = 1 - Math.pow(1-p, 3);
    el.textContent = Math.round(current + (target-current) * eased);
    if (p < 1) requestAnimationFrame(step);
  }
  requestAnimationFrame(step);
}

// Load VMs
async function loadVMs() {
  const btn = document.getElementById('refreshBtn');
  if (btn) btn.classList.add('is-loading');
  
  try {
    const res = await fetch('/api/admin/vms');
    if (!res.ok) throw new Error('Failed to fetch VMs');
    allVMs = await res.json();
    
    const total = allVMs.length;
    const running = allVMs.filter(v => v.status === 'running').length;
    const stopped = allVMs.filter(v => v.status === 'stopped').length;
    const totalMem = allVMs.reduce((s,v) => s + (v.memory || 0), 0);

    animateNumber('totalCount', total);
    animateNumber('runningCount', running);
    animateNumber('stoppedCount', stopped);
    document.getElementById('totalMemory').textContent = formatMem(totalMem);
    document.getElementById('lastUpdate').textContent = `· Updated ${formatTime()}`;

    renderVMs();
  } catch(e) {
    document.getElementById('vmContainer').innerHTML = `
      <div class="empty-state">
        <div class="empty-state-icon" style="color:#EF4444"><svg width="48" height="48"><use href="#i-alert"/></svg></div>
        <div class="empty-state-title">Failed to load VMs</div>
        <div class="empty-state-desc">${escHtml(e.message)}</div>
        <button class="btn btn-primary" onclick="loadVMs()">
          <svg width="13" height="13"><use href="#i-refresh"/></svg> Try Again
        </button>
      </div>`;
    showToast('Failed to load VMs: ' + e.message, 'error');
  } finally {
    setTimeout(() => btn && btn.classList.remove('is-loading'), 500);
  }
}

function filterVMs() { renderVMs(); }

function getFilteredVMs() {
  const q = document.getElementById('vmSearch')?.value.toLowerCase() || '';
  const status = document.getElementById('statusFilter')?.value || '';
  return allVMs.filter(vm => {
    const matchQ = !q || 
      vm.vm_name?.toLowerCase().includes(q) || 
      String(vm.vm_id).includes(q) ||
      vm.os_type?.toLowerCase().includes(q) ||
      vm.template_name?.toLowerCase().includes(q) ||
      vm.ipv4_address?.includes(q);
    const matchStatus = !status || vm.status === status;
    return matchQ && matchStatus;
  });
}

function renderVMs() {
  const filtered = getFilteredVMs();
  const container = document.getElementById('vmContainer');
  
  if (allVMs.length === 0) {
    container.innerHTML = `
      <div class="empty-state">
        <div class="empty-state-icon" style="color:#6366F1"><svg width="48" height="48"><use href="#i-server"/></svg></div>
        <div class="empty-state-title">No Virtual Machines</div>
        <div class="empty-state-desc">Create your first VM to get started with virtualization.</div>
        <a href="/admin/vm-create" class="btn btn-primary">
          <svg width="13" height="13"><use href="#i-plus"/></svg> Create First VM
        </a>
      </div>`;
    return;
  }

  if (filtered.length === 0) {
    container.innerHTML = `
      <div class="empty-state">
        <div class="empty-state-icon" style="color:#6366F1"><svg width="48" height="48"><use href="#i-search"/></svg></div>
        <div class="empty-state-title">No VMs Found</div>
        <div class="empty-state-desc">No VMs match your search criteria. Try a different filter.</div>
      </div>`;
    return;
  }

  if (currentView === 'grid') renderGridView(filtered, container);
  else renderListView(filtered, container);
}

function renderGridView(vms, container) {
  container.innerHTML = `
    <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap: 16px;">
      ${vms.map(vm => renderVMCard(vm)).join('')}
    </div>`;
}

function renderVMCard(vm) {
  const icon = vm.template_icon;
  const displayIcon = (icon && icon.startsWith('http')) ? icon : 'https://i.imgur.com/wu0Ob6B.png';
  const status = vm.status || 'stopped';
  
  return `
    <div class="vm-card ${status}" onclick="window.location.href='/admin/vm/${vm.vm_id}'">
      <div class="vm-header">
        <div style="display: flex; align-items: center; gap: 10px; min-width: 0; flex: 1;">
          <img src="${displayIcon}" alt="OS" style="width: 34px; height: 34px; object-fit: contain; border-radius: 8px; padding: 4px; background: rgba(99,102,241,0.08); border: 1px solid rgba(99,102,241,0.15);" onerror="this.src='https://i.imgur.com/wu0Ob6B.png'">
          <div style="min-width:0; flex:1;">
            <div class="vm-name">${escHtml(vm.vm_name)}</div>
            <div class="vm-os">${escHtml(vm.template_name || vm.os_type || 'Custom')} · #${vm.vm_id}</div>
          </div>
        </div>
        <span class="badge ${getStatusClass(status)}" style="flex-shrink: 0;">
          <span class="dot"></span>${status}
        </span>
      </div>
      <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 10px; font-size: 12px; padding: 12px; background: rgba(255,255,255,0.02); border: 1px solid var(--border-subtle); border-radius: 8px; margin: 10px 0;">
        <div style="display:flex;align-items:center;gap:8px;">
          <span style="color:#10B981;display:inline-flex;"><svg width="14" height="14"><use href="#i-mem"/></svg></span>
          <div><div style="color:var(--text-muted);font-size:10px;text-transform:uppercase;">RAM</div><strong style="color:var(--text-primary);">${vm.memory || '—'} MB</strong></div>
        </div>
        <div style="display:flex;align-items:center;gap:8px;">
          <span style="color:#EC4899;display:inline-flex;"><svg width="14" height="14"><use href="#i-cpu"/></svg></span>
          <div><div style="color:var(--text-muted);font-size:10px;text-transform:uppercase;">vCPUs</div><strong style="color:var(--text-primary);">${vm.cpus || '—'}</strong></div>
        </div>
        <div style="display:flex;align-items:center;gap:8px;">
          <span style="color:#06B6D4;display:inline-flex;"><svg width="14" height="14"><use href="#i-disk"/></svg></span>
          <div><div style="color:var(--text-muted);font-size:10px;text-transform:uppercase;">Disk</div><strong style="color:var(--text-primary);">${vm.disk_size || '—'}</strong></div>
        </div>
        <div style="display:flex;align-items:center;gap:8px;">
          <span style="color:#3B82F6;display:inline-flex;"><svg width="14" height="14"><use href="#i-network"/></svg></span>
          <div><div style="color:var(--text-muted);font-size:10px;text-transform:uppercase;">Network</div><strong style="color:var(--text-primary);">${vm.ipv4_address || vm.network_type || 'DHCP'}</strong></div>
        </div>
      </div>
      <div class="vm-actions" onclick="event.stopPropagation()">
        ${status === 'stopped' 
          ? `<button class="btn btn-success btn-sm" onclick="vmAction('start', ${vm.vm_id}, '${escHtml(vm.vm_name)}')"><svg width="12" height="12"><use href="#i-play"/></svg> Start</button>`
          : `<button class="btn btn-warning btn-sm" onclick="vmAction('stop', ${vm.vm_id}, '${escHtml(vm.vm_name)}')"><svg width="12" height="12"><use href="#i-stop"/></svg> Stop</button>`
        }
        <a href="/admin/vm/${vm.vm_id}/edit" class="btn btn-primary btn-sm"><svg width="12" height="12"><u