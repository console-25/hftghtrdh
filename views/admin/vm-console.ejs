" height="12"><use href="#i-info"/></svg> Details</a>
        <a href="/admin/vm/${vm.vm_id}/console" class="btn btn-ghost btn-sm"><svg width="12" height="12"><use href="#i-terminal"/></svg> Console</a>
      </div>
    </div>
  `;
}

function renderListView(vms, container) {
  container.innerHTML = `
    <div class="card">
      <div class="table-container">
        <table class="table">
          <thead>
            <tr>
              <th>VM</th>
              <th>Status</th>
              <th>Resources</th>
              <th>Disk</th>
              <th>Network</th>
              <th style="text-align:right;">Actions</th>
            </tr>
          </thead>
          <tbody>
            ${vms.map(vm => {
              const icon = vm.template_icon;
              const displayIcon = (icon && icon.startsWith('http')) ? icon : 'https://i.imgur.com/wu0Ob6B.png';
              const status = vm.status || 'stopped';
              return `
              <tr>
                <td>
                  <div style="display: flex; align-items: center; gap: 12px;">
                    <img src="${displayIcon}" style="width: 32px; height: 32px; object-fit: contain; border-radius: 8px; padding: 4px; background: rgba(99,102,241,0.08); border: 1px solid rgba(99,102,241,0.15);" onerror="this.src='https://i.imgur.com/wu0Ob6B.png'">
                    <div>
                      <a href="/admin/vm/${vm.vm_id}" class="strong" style="text-decoration: none; color: var(--text-primary); font-weight:600;">${escHtml(vm.vm_name)}</a>
                      <div style="font-size: 11px; color: var(--text-muted); margin-top:2px;">
                        <span style="background:rgba(99,102,241,0.1);color:#6366F1;padding:1px 7px;border-radius:5px;font-family:monospace;font-weight:600;">#${vm.vm_id}</span>
                        <span style="margin-left:6px;">${escHtml(vm.template_name || vm.os_type || 'Custom')}</span>
                      </div>
                    </div>
                  </div>
                </td>
                <td>
                  <span class="badge ${getStatusClass(status)}">
                    <span class="dot"></span>${status}
                  </span>
                </td>
                <td>
                  <div style="display: flex; gap: 12px; font-size: 12px;">
                    <div style="display: flex; align-items: center; gap: 5px;" title="vCPUs">
                      <span style="color:#EC4899;display:inline-flex;"><svg width="12" height="12"><use href="#i-cpu"/></svg></span>
                      <strong style="color: var(--text-primary);">${vm.cpus || '—'}</strong>
                    </div>
                    <div style="display: flex; align-items: center; gap: 5px;" title="Memory">
                      <span style="color:#10B981;display:inline-flex;"><svg width="12" height="12"><use href="#i-mem"/></svg></span>
                      <strong style="color: var(--text-primary);">${formatMem(vm.memory)}</strong>
                    </div>
                  </div>
                </td>
                <td>
                  <div style="display:flex;align-items:center;gap:6px;font-size:12px;">
                    <span style="color:#06B6D4;display:inline-flex;"><svg width="12" height="12"><use href="#i-disk"/></svg></span>
                    <strong style="color: var(--text-primary);">${vm.disk_size || '—'}</strong>
                  </div>
                </td>
                <td style="font-size: 12px;">
                  <div style="color:var(--text-primary);font-weight:500;">${vm.ipv4_address || (vm.network_type === 'dhcp' ? 'DHCP' : '—')}</div>
                  <div style="color: var(--text-muted); font-family:monospace; font-size:10px; margin-top:2px;">SSH: ${vm.ssh_port || vm.ssh_port_static || '22'}</div>
                </td>
                <td>
                  <div style="display: flex; gap: 6px; align-items: center; justify-content:flex-end; flex-wrap: wrap;">
                    ${status === 'stopped'
                      ? `<button class="btn btn-success btn-sm btn-icon" onclick="vmAction('start', ${vm.vm_id}, '${escHtml(vm.vm_name)}')" title="Start"><svg width="13" height="13"><use href="#i-play"/></svg></button>`
                      : `<button class="btn btn-warning btn-sm btn-icon" onclick="vmAction('stop', ${vm.vm_id}, '${escHtml(vm.vm_name)}')" title="Stop"><svg width="13" height="13"><use href="#i-stop"/></svg></button>`
                    }
                    <button class="btn btn-ghost btn-sm btn-icon" onclick="vmAction('restart', ${vm.vm_id}, '${escHtml(vm.vm_name)}')" title="Restart"><svg width="13" height="13"><use href="#i-restart"/></svg></button>
                    <a href="/admin/vm/${vm.vm_id}/edit" class="btn btn-primary btn-sm btn-icon" title="Edit"><svg width="13" height="13"><use href="#i-edit"/></svg></a>
                    <a href="/admin/vm/${vm.vm_id}" class="btn btn-outline btn-sm btn-icon" title="Details"><svg width="13" height="13"><use href="#i-info"/></svg></a>
                    <a href="/admin/vm/${vm.vm_id}/console" class="btn btn-ghost btn-sm btn-icon" title="Console"><svg width="13" height="13"><use href="#i-terminal"/></svg></a>
                    <button class="btn btn-danger btn-sm btn-icon" onclick="confirmDelete(${vm.vm_id}, '${escHtml(vm.vm_name)}')" title="Delete"><svg width="13" height="13"><use href="#i-trash"/></svg></button>
                  </div>
                </td>
