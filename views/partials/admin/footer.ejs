<script>
let allVMs = [];
let currentView = 'list';

function formatMem(mem) {
  if (!mem) return '—';
  return mem >= 1024 ? (mem / 1024).toFixed(1) + ' GB' : mem + ' MB';
}

function formatTime() {
  return new Date().toLocaleTimeString('en-US', { hour: '2-digit', minute: '2-digit', second: '2-digit' });
}

function getStatusClass(status) {
  return status || 'stopped';
}

function setView(view) {
  currentView = view;
  document.getElementById('viewGrid').classList.toggle('active', view === 'grid');
  document.getElementById('viewList').classList.toggle('active', view === 'list');
  renderVMs();
}

function quickFilter(status) {
  document.getElementById('statusFilter').value = status;
  document.querySelectorAll('.stat-card-enhanced[data-filter]').forEach(c => {
    c.classList.toggle('active', c.dataset.filter === status);
  });
  renderVMs();
}

async function loadVMs() {
  const btn = document.getElementById('refreshBtn');
  btn.classList.add('spinning');
  
  try {
    const res = await fetch('/api/vms');
    if (!res.ok) throw new Error('Failed to fetch VMs');
    allVMs = await res.json();
    
    const total = allVMs.length;
    const running = allVMs.filter(v => v.status === 'running').length;
    const stopped = allVMs.filter(v => v.status === 'stopped').length;
    const totalMem = allVMs.reduce((s, v) => s + (v.memory || 0), 0);

    animateNumber('totalCount', total);
    animateNumber('runningCount', running);
    animateNumber('stoppedCount', stopped);
    document.getElementById('totalMemory').textContent = formatMem(totalMem);
    document.getElementById('lastUpdate').textContent = `· Updated ${formatTime()}`;

    renderVMs();
  } catch(e) {
    document.getElementById('vmContainer').innerHTML = `
      <div class="empty-enhanced">
        <div class="empty-icon-wrap" style="color: var(--color-red); background: linear-gradient(135deg, var(--color-red-light), rgba(239,68,68,0.05));">
          <svg class="icon"><use href="#i-alert"/></svg>
        </div>
        <div class="empty-title">Failed to Load VMs</div>
        <div class="empty-desc">${escHtml(e.message)}</div>
        <button class="btn-refresh" onclick="loadVMs()">
          <svg class="icon"><use href="#i-refresh"/></svg> Try Again
        </button>
      </div>`;
    showToast('Failed to load VMs: ' + e.message, 'error');
  } finally {
    setTimeout(() => btn.classList.remove('spinning'), 500);
  }
}

