ase().includes(q) ||
      vm.template_name?.toLowerCase().includes(q) ||
      vm.ipv4_address?.includes(q);
    const matchStatus = !status || vm.status === status;
    return matchQ && matchStatus;
  });
}

function renderVMs() {
  const filtered = getFilteredVMs();
  const container = document.getElementById('vmContainer');
  
  if (allVMs.length === 0) {
    container.innerHTML = `
      <div class="empty-enhanced">
        <div class="empty-icon-wrap"><svg class="icon"><use href="#i-server"/></svg></div>
        <div class="empty-title">No Virtual Machines</div>
        <div class="empty-desc">You don't have any VMs assigned yet. Contact your administrator to request virtual machines.</div>
      </div>`;
    return;
  }

  if (filtered.length === 0) {
    container.innerHTML = `
      <div class="empty-enhanced">
        <div class="empty-icon-wrap"><svg class="icon"><use href="#i-search"/></svg></div>
        <div class="empty-title">No VMs Found</div>
        <div class="empty-desc">No VMs match your search criteria. Try a different filter.</div>
      </div>`;
    return;
  }

  if (currentView === 'grid') {
    renderGridView(filtered, container);
  } else {
    renderListView(filtered, container);
  }
}

